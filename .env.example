# Server-side Etherscan API V2 key. Never use a VITE_ prefix for this secret.
ETHERSCAN_API_KEY=
# Used only by the optional local Express API server.
PORT=8787

# Firebase Web App configuration (public client config; set these in Vercel too).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
